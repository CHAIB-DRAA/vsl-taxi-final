{
  "expo": {
    "name": "vsl-mobile",
    "slug": "taxi-vsl",
    "owner": "chaibdraa",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mostafa27001.vslmobile",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      },
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "package": "com.mostafa27001.vslmobile",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f68975be-b983-42cc-a7f9-0588c132f989"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "L'application a besoin d'accéder à votre calendrier pour y ajouter vos courses automatiquement."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour scanner les documents.",
          "cameraPermission": "L'application a besoin d'accéder à la caméra pour scanner les bons de transport."
        }
      ]
    ],
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/f68975be-b983-42cc-a7f9-0588c132f989"
    }
  }
}
