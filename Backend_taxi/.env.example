# =============================================
# CONFIGURATION REQUISE - Copiez ce fichier en .env
# =============================================

# Base de données MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Clé secrète JWT - DOIT faire au moins 32 caractères aléatoires
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_avec_une_cle_aleatoire_de_32_caracteres_minimum

# Mot de passe du panel administrateur
ADMIN_PASSWORD=CHANGEZ_MOI

# Email Gmail pour les notifications (utilisez un App Password Google, pas votre vrai mot de passe)
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# Clé API OpenAI (pour le parsing IA des courses)
OPENAI_API_KEY=sk-proj-...

# Supabase (stockage des documents)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# CORS : origines autorisées (séparées par des virgules)
# Laissez vide pour autoriser toutes les origines (développement uniquement)
# Exemple: https://vsl-taxi.onrender.com,https://mon-portail.com
ALLOWED_ORIGINS=

# Port du serveur (optionnel, Render le définit automatiquement)
PORT=10000
